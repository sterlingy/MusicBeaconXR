{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "beacon-field",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "web/serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "beacon-field-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "web/serve.py",
        "8777"
      ],
      "port": 8777,
      "autoPort": false
    },
    {
      "name": "site-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        "build/site"
      ],
      "port": 8790
    }
  ]
}