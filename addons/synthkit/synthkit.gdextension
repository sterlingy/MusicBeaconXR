[configuration]

entry_symbol = "jamcore_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/synthkit/bin/jamcore.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/synthkit/bin/jamcore.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://addons/synthkit/bin/libjamcore.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/synthkit/bin/libjamcore.android.template_release.arm64.so"
