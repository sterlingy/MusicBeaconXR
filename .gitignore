.godot/
*.import
*.translation
export_presets.cfg

# Python / Node
__pycache__/
node_modules/

# Claude Code local settings
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store

# Local HTTPS certificate (web/serve.py --https)
web/.cert/

# Export output
build/

# Listening demos rendered by tools/prism_demo.gd (large; regenerate any time)
media/prism-demos/

# Private credentials (Supabase): never committed
.env.supabase

# Audio analysis: the Python environment (PyTorch, Demucs) and the songs and stems it works on
tools/.venv/
analysis/

# Sample libraries (sources for a curated pack); never in git or app exports
samples_src/

# Sample pack build log (the packs themselves, samples/ and web/samples/, are committed)
tools/build_samples.log
tests_scene.log
# Android build template (Project > Install Android Build Template); used by gradle builds (Android XR)
/android/
